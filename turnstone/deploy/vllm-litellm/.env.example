# LiteLLM max-config environment. Copy to .env and edit.
# Provenance: Turnstone default / LiteLLM built-in / OptiStack reference.

# === Core gateway secrets (LiteLLM built-in) ===
LITELLM_MASTER_KEY=              # dev: open boot + warning; prod: REQUIRED (sk-$(openssl rand -hex 32))
LITELLM_SALT_KEY=                # LiteLLM built-in (hashing salt; set for prod)
LITELLM_DANGEROUSLY_PERMIT_WEAK_OR_UNSET_MASTER_KEY=true  # dev only; MUST be absent in prod

# === Budgets (Turnstone default) ===
MAX_BUDGET_USD=0                 # 0 = unset; maps to litellm_settings.max_budget
LITELLM_MAX_BUDGET=              # alias/empty = unset (warn-if-set-without-DB)
LITELLM_BUDGET_DURATION=         # e.g. 30d, 1h (empty = unset)
LITELLM_TAG_BUDGETS_JSON='{}'    # Turnstone default
LITELLM_KEY_UPPERBOUNDS_JSON='{}'

# === Reliability S01 (OptiStack reference + LiteLLM built-in) ===
LITELLM_NUM_RETRIES=5
LITELLM_REQUEST_TIMEOUT=600
LITELLM_ROUTING_STRATEGY=simple-shuffle
LITELLM_ALLOWED_FAILS=3
LITELLM_COOLDOWN_TIME=30
QWEN_TIMEOUT=600
QWEN_STREAM_TIMEOUT=300
QWEN_NUM_RETRIES=5
QWEN_COOLDOWN_TIME=30
GEMMA_TIMEOUT=300
GEMMA_STREAM_TIMEOUT=300
GEMMA_NUM_RETRIES=5
GEMMA_COOLDOWN_TIME=30

# === Fallbacks / paid tails S02 (Turnstone default) ===
QWEN_PAID_MODEL=
QWEN_PAID_API_BASE=
QWEN_PAID_API_KEY=               # empty = paid tail DISABLED
QWEN_PAID_TIMEOUT=600
QWEN_PAID_STREAM_TIMEOUT=300
QWEN_PAID_NUM_RETRIES=3
QWEN_PAID_COOLDOWN_TIME=60
GEMMA_PAID_MODEL=
GEMMA_PAID_API_BASE=
GEMMA_PAID_API_KEY=              # empty = paid tail DISABLED
GEMMA_PAID_TIMEOUT=300
GEMMA_PAID_STREAM_TIMEOUT=300
GEMMA_PAID_NUM_RETRIES=3
GEMMA_PAID_COOLDOWN_TIME=60
QWEN_PAID_INPUT_COST=
QWEN_PAID_OUTPUT_COST=
GEMMA_PAID_INPUT_COST=
GEMMA_PAID_OUTPUT_COST=
LITELLM_FALLBACKS_JSON='[]'
LITELLM_CONTEXT_WINDOW_FALLBACKS_JSON='[]'
LITELLM_CONTENT_POLICY_FALLBACKS_JSON='[]'
LITELLM_DEFAULT_FALLBACKS_JSON='[]'
LITELLM_MODEL_GROUP_ALIAS_JSON='{}'
LITELLM_MAX_FALLBACKS=5

# === Affinity S03 (LiteLLM built-in) ===
LITELLM_PRE_CALL_CHECKS_JSON='["session_affinity","prompt_caching"]'
LITELLM_AFFINITY_TTL=3600
LITELLM_GROUP_AFFINITY_JSON='{}'

# === Cache / budgets S04 (Turnstone default) ===
LITELLM_CACHE_ENABLED=True
LITELLM_CACHE_TYPE=local
LITELLM_CACHE_TTL=3600

# === Guardrails S05 (Turnstone default) ===
LITELLM_SECRETS_GUARD=on
LITELLM_PII_GUARD=mask
LITELLM_AUDIT_GUARD=on

# === General settings S06 (LiteLLM built-in) ===
LITELLM_BG_HEALTH_CHECKS=True
LITELLM_HEALTH_INTERVAL=300
LITELLM_HEALTH_STALENESS=600
LITELLM_HEALTH_ROUTING=True
LITELLM_ALERTING_JSON='[]'
LITELLM_ALERT_THRESHOLD=300
LITELLM_ALERT_TYPES_JSON='["llm_exceptions","llm_too_slow","llm_requests_hanging","budget_alerts","cooldown_deployment"]'
LITELLM_ALERT_WEBHOOK_JSON='{}'
LITELLM_LOG_MESSAGES=False
LITELLM_STORE_PROMPTS=True

# === Images / models / ports (Turnstone default) ===
VLLM_IMAGE=vllm/vllm-openai:latest
LITELLM_TAG=v1.97.0
HF_TOKEN=
HF_CACHE=./hf-cache
QWEN_MODEL=nvidia/Qwen3.6-27B-NVFP4
GEMMA_MODEL=google/gemma-4-12b-it
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
LITELLM_PORT=4000
QWEN_PORT=8000
GEMMA_PORT=8001
RERANKER_PORT=8002
" filePath=C:/Utilities/AI/turnstone/turnstone/deploy/vllm-litellm/.env.example